---
// btop-style graph of weekly GitHub contributions, from the same data as the /about calendar
// (src/data/activity.json, refreshed by CI). Drawn as SVG so it scales to the pane on any width.
import data from '../data/activity.json';

const { login, generated, start, counts } = data as { login: string; generated: string; start: string; counts: number[] };
const DAY = 86_400_000;
const t0 = Date.parse(`${start}T00:00:00Z`);
const MONTHS = ['jan', 'feb', 'mar', 'apr', 'may', 'jun', 'jul', 'aug', 'sep', 'oct', 'nov', 'dec'];

const weeks = Array.from({ length: Math.ceil(counts.length / 7) }, (_, w) => counts.slice(w * 7, w * 7 + 7).reduce((a, b) => a + b, 0));
const max = Math.max(1, ...weeks);

// bars on a 4-unit grid: 3 wide, 1 gap; a sqrt scale keeps quiet weeks visible next to the big ones
const W = weeks.length * 4, H = 40;
const bars = weeks.map((n, i) => {
  const h = n ? Math.max(2, Math.round(Math.sqrt(n / max) * H)) : 0;
  const lvl = n === 0 ? 0 : n / max > 0.6 ? 3 : n / max > 0.25 ? 2 : 1;
  return { x: i * 4, h, lvl, n };
});

// month ticks under the first week that contains the 1st
const ticks: { pct: number; m: string }[] = [];
for (let w = 0; w < weeks.length; w++) {
  for (let d = 0; d < 7; d++) {
    const date = new Date(t0 + (w * 7 + d) * DAY);
    if (date.getUTCDate() === 1 && w * 7 + d < counts.length) ticks.push({ pct: (w * 4 * 100) / W, m: MONTHS[date.getUTCMonth()] });
  }
}

const total = counts.reduce((a, b) => a + b, 0);
let longest = 0, run = 0;
for (const n of counts) { run = n ? run + 1 : 0; longest = Math.max(longest, run); }
const byMonth = new Map<string, number>();
counts.forEach((n, i) => {
  const d = new Date(t0 + i * DAY);
  const k = `${MONTHS[d.getUTCMonth()]} ${d.getUTCFullYear()}`;
  byMonth.set(k, (byMonth.get(k) ?? 0) + n);
});
const [busiest] = [...byMonth].sort((a, b) => b[1] - a[1]);
const fmt = (n: number) => n.toLocaleString('en-US');
const summary = `${fmt(total)} GitHub contributions in the last year, longest streak ${longest} days, busiest month ${busiest[0]}`;
---
<div class="spark">
  <svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="none" role="img" aria-label={`Weekly contributions: ${summary}`}>
    <line x1="0" x2={W} y1={H - 0.5} y2={H - 0.5} class="sp-base" />
    {bars.map((b) => b.h > 0 && <rect x={b.x} y={H - b.h} width="3" height={b.h} class={`sp-l${b.lvl}`}><title>{`${b.n} that week`}</title></rect>)}
  </svg>
  <div class="sp-ticks" aria-hidden="true">{ticks.map((t) => <span style={`left:${t.pct.toFixed(1)}%`}>{t.m}</span>)}</div>
  <p class="sp-sum">
    <strong>{fmt(total)}</strong> contributions · streak <strong>{longest}</strong>d · busiest <strong>{busiest[0]}</strong>
  </p>
  <p class="sp-note">weekly, from my <a href={`https://github.com/${login}`}>GitHub</a>, mostly private repos · {generated}</p>
</div>

<style>
  .spark svg { display: block; width: 100%; height: 56px; }
  .sp-base { stroke: var(--faint); stroke-width: 1; vector-effect: non-scaling-stroke; }
  .sp-l1 { fill: color-mix(in srgb, var(--green) 45%, var(--bg)); }
  .sp-l2 { fill: color-mix(in srgb, var(--green) 72%, var(--bg)); }
  .sp-l3 { fill: var(--green); }
  .spark rect:hover { fill: var(--amber); }
  .sp-ticks { position: relative; height: 1.4em; font-size: 11.5px; color: var(--dim); }
  .sp-ticks span { position: absolute; top: 0; }
  /* every other month on narrow panes so the labels don't collide */
  @media (max-width: 640px) { .sp-ticks span:nth-child(even) { display: none; } }
  .sp-sum { margin: 0.2rem 0 0; }
  .sp-note { margin: 0; color: var(--dim); font-size: 13px; }
</style>
