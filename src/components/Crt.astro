---
// One screenshot or looping clip behind a CRT "glass": scanlines, vignette, phosphor glow.
// The effect is CSS only, so the media files stay clean. Clips are muted MP4/WebM (a GIF would be 10x bigger);
// scripts/crt.ts plays them only while on screen, and never with reduced motion (the poster shows instead).
interface Props {
  src: string; // still image; the poster when there is a clip
  alt: string;
  video?: string; // path without extension; expects .webm and .mp4 next to each other
  size?: [number, number]; // still's pixel size; defaults to a phone screenshot
}
const { src, alt, video, size = [540, 1170] } = Astro.props;
const [width, height] = size;
const wide = width > height;
---
<figure class={`crt-fig${wide ? ' wide' : ''}`}>
  <div class={`crt${video ? ' is-clip' : ''}`}>
    {video ? (
      <video muted loop playsinline preload="none" poster={src} aria-label={alt} width={width} height={height} data-crt>
        <source src={`${video}.webm`} type="video/webm" />
        <source src={`${video}.mp4`} type="video/mp4" />
      </video>
    ) : (
      <img src={src} alt={alt} loading="lazy" width={width} height={height} />
    )}
  </div>
  <figcaption>{video && <span class="rec" aria-hidden="true">● </span>}{alt}</figcaption>
</figure>
