  a: '#120c0b', b: '#0b0706', c: '#3a2925', d: '#2a2222', e: '#201513', f: '#4b342d', g: '#e58e61',
  h: '#fcbe89', i: '#f7f6f9', j: '#b97d5b', k: '#6a493a', l: '#e4ae85', m: '#885d48', t: '#232643',
  u: '#33395c', R: '#e33810', Y: '#f2c01b', U: '#4076bd', G: '#4ca050',
};

