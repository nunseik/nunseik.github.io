// one <path> per colour per layer, built from horizontal runs of the same char
function paths(layer: keyof typeof L) {
  const [y0, grid] = L[layer];
  const d: Record<string, string> = {};
  grid.slice(1).split('\n').forEach((row, y) => {
    for (let x = 0; x < row.length; ) {
      const ch = row[x];
      let n = 1;
      while (row[x + n] === ch) n++;
      if (P[ch] || ch === '~') d[ch] = (d[ch] ?? '') + `M${x} ${y + y0}h${n}v1h-${n}z`;
      x += n;
    }
  });
  return Object.entries(d).map(([ch, path]) => ({ fill: P[ch] ?? 'currentColor', path }));
}
const g = Object.fromEntries(Object.keys(L).map((k) => [k, paths(k as keyof typeof L)]));
// 41 x 73 plus a pixel for the bob and a 1 px rim all round
const vb = { x: -1, y: -1, w: 43, h: 75 };
---
<div class="me" data-me>
  <button type="button" class="me-btn" aria-label="Pixel-art Fabio. Say hi.">
    <svg viewBox={`${vb.x} ${vb.y} ${vb.w} ${vb.h}`} shape-rendering="crispEdges" aria-hidden="true">
      <defs>
        <!-- a 1 px rim (4-neighbour, like a hand-drawn pixel outline) so the dark outline reads on the dark page -->
        <filter id="me-rim" filterUnits="userSpaceOnUse" x={vb.x} y={vb.y} width={vb.w} height={vb.h} color-interpolation-filters="sRGB">
          <feOffset in="SourceAlpha" dx="1" result="r" />
          <feOffset in="SourceAlpha" dx="-1" result="l" />
          <feOffset in="SourceAlpha" dy="1" result="d" />
          <feOffset in="SourceAlpha" dy="-1" result="u" />
          <feMerge result="m"><feMergeNode in="r" /><feMergeNode in="l" /><feMergeNode in="d" /><feMergeNode in="u" /></feMerge>
          <feFlood class="me-rim" />
          <feComposite in2="m" operator="in" result="rim" />
          <feMerge><feMergeNode in="rim" /><feMergeNode in="SourceGraphic" /></feMerge>
        </filter>
      </defs>
      <g class="me-shadow">{g.shadow.map((p) => <path d={p.path} />)}</g>
      <g filter="url(#me-rim)">
        <g>{g.legs.map((p) => <path fill={p.fill} d={p.path} />)}</g>
        <g class="me-up">
          {g.upper.map((p) => <path fill={p.fill} d={p.path} />)}
          <g class="me-open">{g.eyes.map((p) => <path fill={p.fill} d={p.path} />)}</g>
          <g class="me-shut">{g.shut.map((p) => <path fill={p.fill} d={p.path} />)}</g>
          <g class="me-arm">{g.arm.map((p) => <path fill={p.fill} d={p.path} />)}</g>
          <g class="me-w1">{g.wave1.map((p) => <path fill={p.fill} d={p.path} />)}</g>
          <g class="me-w2">{g.wave2.map((p) => <path fill={p.fill} d={p.path} />)}</g>
        </g>
      </g>
    </svg>
  </button>
  <p class="me-say" role="status" aria-live="polite"></p>
</div>

<script src="../scripts/me.ts"></script>
