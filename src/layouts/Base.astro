---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  file: string; // path shown in the statusline, e.g. ~/projects/sentinel.md
  description?: string;
  tab?: 'home' | 'projects' | 'tools' | 'about' | null;
  filetype?: string;
}

const { title, file, description = 'Portfolio of Fabio Fernandes: software, automation and AI tooling.', tab = null, filetype = 'markdown' } = Astro.props;

const tabs = [
  { id: 'home', label: 'index.md', href: '/' },
  { id: 'projects', label: 'projects/', href: '/projects/' },
  { id: 'tools', label: 'ai-tooling.md', href: '/tools/' },
  { id: 'about', label: 'about.md', href: '/about/' },
] as const;

// slugs for the `:e <name>` command
const projects = (await getCollection('projects')).map((p) => ({ id: p.id, title: p.data.title }));
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title === 'Fabio Fernandes' ? title : `${title} · Fabio Fernandes`}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0e110f" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600;700&display=swap" rel="stylesheet" />
    {tab === 'home' && (
      <script is:inline>
        // First home visit of the session: hide lines before first paint so the intro can print them.
        try {
          if (!matchMedia('(prefers-reduced-motion: reduce)').matches && !sessionStorage.getItem('intro')) {
            sessionStorage.setItem('intro', '1');
            document.documentElement.classList.add('intro');
          }
        } catch (e) {}
      </script>
    )}
  </head>
  <body>
    <a href="#buf" class="sr-skip" style="position:absolute;left:-999px">Skip to content</a>
    <nav class="tabline" aria-label="Buffers">
      {tabs.map((t, i) => (
        <a href={t.href} aria-current={tab === t.id ? 'page' : undefined} data-tab={i + 1}>
          <span class="n">{i + 1}</span>{t.label.replace(/\.md$/, '')}{t.label.endsWith('.md') && <span class="ext">.md</span>}
        </a>
      ))}
      <span class="fill"></span>
      <span class="host">fabio@nunseik</span>
    </nav>

    <main id="buf">
      <slot />
    </main>

    <footer class="status">
      <div class="statusline">
        <span class="mode" id="mode">NORMAL</span>
        <span class="file">{file}</span>
        <span class="fill"></span>
        <span class="meta">utf-8</span>
        <span class="meta">{filetype}</span>
        <span class="pos" id="pos">Top</span>
      </div>
      <div class="cmdline" id="cmdline">
        <span class="msg" id="msg">type :help or press ? for keys</span>
        <form id="cmdform" autocomplete="off">
          <span class="green" id="cmdprefix">:</span><input id="cmd" aria-label="Command" spellcheck="false" autocapitalize="off" />
        </form>
        <button type="button" id="cmdbtn" aria-label="Open command line">:</button>
      </div>
    </footer>

    <dialog id="help" aria-labelledby="help-title">
      <h2 id="help-title">:help portfolio</h2>
      <dl class="kv">
        <dt>j / k</dt><dd>next / previous link (scrolls through long text)</dd>
        <dt>Enter</dt><dd>open the selected link</dd>
        <dt>gg / G</dt><dd>top / bottom</dd>
        <dt>Ctrl-d / Ctrl-u</dt><dd>half page down / up</dd>
        <dt>/text · n / N</dt><dd>search the page · next / previous match</dd>
        <dt>Ctrl-o / Ctrl-i</dt><dd>jump back / forward</dd>
        <dt>1–4</dt><dd>switch buffer (tabs)</dd>
        <dt>-</dt><dd>go up a directory</dd>
        <dt>:e &lt;name&gt;</dt><dd>open a project, e.g. <code>:e sentinel</code> or <code>:e memoryctl</code></dd>
        <dt>:ls</dt><dd>list projects</dd>
        <dt>:q</dt><dd>close the buffer (back to index.md), then try it again</dd>
      </dl>
      <p class="dim">Mouse and touch work too. Esc closes this.</p>
    </dialog>

    <script type="application/json" id="projects-data" set:html={JSON.stringify(projects)} />
    <script src="../scripts/vim.ts"></script>
    <script src="../scripts/anim.ts"></script>
  </body>
</html>
